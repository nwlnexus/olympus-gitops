# memory-workers-config, generated by kustomize (configMapGenerator in kustomization.yaml) so the name
# carries a content hash: any change here rolls both worker Deployments on the next Flux reconcile
# (the workers read their environment only at start; olympus-sdk#591). KEY=value, no quotes.

# --- shared by both stages (envFrom) ------------------------------------------------------
# Listener for /metrics, /healthz and /readyz (defaults of the worker, spelled out so the probes,
# the scrape annotations and the NetworkPolicy have one visible source).
MEMORY_HOST=0.0.0.0
MEMORY_METRICS_PORT=9090
LOG_LEVEL=INFO
# The cluster LiteLLM (../../inference, olympus-sdk#569): memory-extract goes to the A9 llama-server and
# has no fallback (olympus-sdk#701; a failed job is retried by the worker). The API key is NOT here: it is in Secret memory-workers (LITELLM_API_KEY_FILE),
# and the proxy maps it to client `memory-workers` (scope: memory-extract only). The inference namespace
# admits this pod (memory-worker-extract) on 4000; egress from ns memory is unrestricted.
LITELLM_BASE_URL=http://litellm.inference.svc:4000/v1
MEMORY_EXTRACT_ALIAS=memory-extract
# Per-call LLM timeout: llama-server (#588) does about 90 tok/s prompt and 9 tok/s output on the 27B,
# so a max-size chunk can need more than the 300 s default. Above LiteLLM's worst case (A9 300 s plus a
# retry, ../../inference/litellm-config.yaml) and below the servers' 900 s.
MEMORY_EXTRACT_TIMEOUT_SECONDS=540
MEMORY_EMBED_ALIAS=memory-embed
# Embeddings come from the dedicated in-cluster service (memory-embedder, olympus-sdk#529), not LiteLLM/Ollama
# (Ollama's embedder stalls under load, olympus-sdk#527). The cluster LiteLLM has no memory-embed alias, so
# there is no LiteLLM fallback for embeddings. The client
# appends /embeddings to a base URL that ends in /v1. Service mode defaults: 60 s timeout, concurrency 2.
MEMORY_EMBED_BASE_URL=http://memory-embedder.memory.svc/v1
MEMORY_EMBED_MODEL=nomic-embed-text-v1.5
# Postgres graph (design 14.7, olympus-sdk#516). `true` writes the graph of up to MEMORY_GRAPH_INLINE_MAX
# (default 12) new facts per episode in the extract transaction and claims graph_ingest. On since the
# golden-set evaluation passed on the real model (olympus-sdk#517). `false` is the kill switch: extract
# writes facts only (graph_revision stays NULL, the backfill picks them up later), graph_ingest is not
# claimed, the backfill does nothing. Flip together with the gateway's MEMORY_GRAPH_ENQUEUE.
MEMORY_GRAPH_ENABLED=true
# Backlog (priority >= 200) extraction and graph work only from 00:00 to 07:59 UTC (design 8.3, 14.8);
# live captures and remembers (priority < 200) run any time.
MEMORY_EXTRACT_WINDOW=0-7
# Closure of finished to-dos (olympus-sdk#726): suggest = link the to-do (fact.possibly_closed_by, migration 0009)
# and show it as "possibly done" at session start; supersede = hide it; off = nothing. Suggest until the owner
# has reviewed the suggest_closed audit rows.
MEMORY_CLOSURE_MODE=suggest
# Graph backfill (design 14.6, olympus-sdk#519 task W4): graph-extract the facts that have no graph yet (the
# imported backlog; recalled facts first, `full` for recalled/canonical/live facts, `entities` for the rest),
# one job at a time, only when the LLM worker is idle, only inside MEMORY_EXTRACT_WINDOW, never while
# `memory-admin worker pause` holds llm or backfill. It runs only while MEMORY_GRAPH_ENABLED is also true:
# with the graph off it does nothing, and it starts once the graph is turned on.
MEMORY_GRAPH_BACKFILL=true
# --- per stage (referenced one by one with configMapKeyRef) -------------------------------
# extract: the 27B llama-server on the A9 is single-slot, so ONE claim loop in ONE pod, one job per
# claim (the extract stage rejects any other batch size).
extract-concurrency=1
extract-batch-size=1
# embed: 4 claim loops per pod, 4 facts per claim = one /embeddings request (worker defaults).
embed-concurrency=2
embed-batch-size=4
