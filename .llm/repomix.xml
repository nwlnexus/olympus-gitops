<file path="clusters/olympus/mem0/ghcr-pull-externalsecret.yaml">
# Image pull secret for the private ghcr.io/nwlnexus/openmemory-* images.
# Unlike the public claude-mem-server image, these packages are private, so the
# openmemory + openmemory-ui Deployments pull via this dockerconfigjson secret.
# Source: 1Password item `gh-pull-secret` (vault Dev) — fields `username` and
# `credential` (a PAT with read:packages on the nwlnexus org). Reusable across apps.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ghcr-pull
  namespace: mem0
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword-connect
    kind: ClusterSecretStore
  target:
    name: ghcr-pull
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: |
          {"auths":{"ghcr.io":{"username":"{{ .username }}","password":"{{ .token }}","auth":"{{ printf "%s:%s" .username .token | b64enc }}"}}}
  data:
    - secretKey: username
      remoteRef:
        key: gh-pull-secret
        property: username
    - secretKey: token
      remoteRef:
        key: gh-pull-secret
        property: credential
</file>

<file path="clusters/olympus/mem0/init-config-job.yaml">
# mem0-init-config — one-shot post-deploy reconciler for the OpenMemory backend config.
#
# WHY THIS EXISTS:
#   The 768-dim embedding setting (nomic-embed-text) can ONLY be set via the config
#   API — env vars leave embedding_model_dims at mem0's default 1536, so the Qdrant
#   collection would be created with the wrong dimensionality and every add/search
#   silently mismatches.
#
# WHY ALL THREE SECTIONS (llm + embedder + vector_store), not just vector_store:
#   Verified the hard way on the first deploy. get_memory_client() builds config from
#   env (LLM_PROVIDER/EMBEDDER_PROVIDER=ollama) ONLY when there is no DB config row.
#   The moment ANY sub-endpoint is written, a DB "main" config row exists and OVERRIDES
#   env per-section — and writing only vector_store left llm+embedder persisted as the
#   OpenAI defaults (gpt-4o-mini / text-embedding-3-small), so embedding hit OpenAI and
#   failed with "401 Incorrect API key: sk-dummy". Setting all three makes the DB row
#   complete and authoritative (and matches the Deployment env, kept in sync here).
#
# WHY THE /mem0/<section> SUB-ENDPOINTS (not the root PUT /api/v1/config):
#   In this OpenMemory revision (b44ce4d) the root PUT handler is a silent no-op
#   (its save_config_to_db/reset_memory_client/return lines belong to the next handler).
#   The dedicated PUT /api/v1/config/mem0/{llm,embedder,vector_store} handlers DO persist
#   (save + reset memory client) and are what upstream run.sh uses.
#
# IDEMPOTENT: fixed PUT bodies → re-running drives config to the same state.
# backoffLimit + OnFailure tolerate the API not being ready yet. curl has explicit
# --connect-timeout/--max-time so probes fail fast instead of hanging ~134s on a
# blackholed ClusterIP while the API is still starting.
#
# ORDERING CAVEAT: if a memory write reaches OpenMemory before this Job sets dims,
# Qdrant creates "openmemory" at 1536 and mem0 reuses it. Fresh deploys run the Job
# before client traffic; if it ever happens, drop the collection and re-run the Job.
apiVersion: batch/v1
kind: Job
metadata:
  name: mem0-init-config
  namespace: mem0
spec:
  backoffLimit: 10
  template:
    metadata:
      labels:
        app: mem0-init-config
    spec:
      restartPolicy: OnFailure
      containers:
        - name: init-config
          image: curlimages/curl:8.11.1
          command:
            - /bin/sh
            - -c
            - |
              set -eu
              API="http://openmemory.mem0.svc.cluster.local:8765"
              OLLAMA="http://ai-hub.raptor-mimosa.ts.net:11434"

              echo "Waiting for OpenMemory API at ${API}/docs ..."
              i=0
              until curl -fsS --connect-timeout 5 --max-time 15 -o /dev/null "${API}/docs"; do
                i=$((i + 1))
                if [ "$i" -ge 60 ]; then
                  echo "API not ready after ${i} attempts; failing so the Job retries."
                  exit 1
                fi
                echo "  not ready yet (attempt ${i}); sleeping 5s"
                sleep 5
              done
              echo "API is up. Applying mem0 config: embedder + llm + vector_store (ollama/qdrant)."

              curl -fsS --max-time 20 -X PUT "${API}/api/v1/config/mem0/embedder" \
                -H 'Content-Type: application/json' \
                -d "{\"provider\":\"ollama\",\"config\":{\"model\":\"nomic-embed-text\",\"ollama_base_url\":\"${OLLAMA}\"}}"
              echo
              curl -fsS --max-time 20 -X PUT "${API}/api/v1/config/mem0/llm" \
                -H 'Content-Type: application/json' \
                -d "{\"provider\":\"ollama\",\"config\":{\"model\":\"qwen2.5:7b-instruct\",\"temperature\":0.1,\"max_tokens\":2000,\"ollama_base_url\":\"${OLLAMA}\"}}"
              echo
              curl -fsS --max-time 20 -X PUT "${API}/api/v1/config/mem0/vector_store" \
                -H 'Content-Type: application/json' \
                -d "{\"provider\":\"qdrant\",\"config\":{\"collection_name\":\"openmemory\",\"embedding_model_dims\":768,\"host\":\"qdrant.mem0.svc.cluster.local\",\"port\":6333}}"
              echo
              echo "Config applied. Verifying (non-fatal) ..."
              curl -fsS --max-time 10 "${API}/api/v1/config/mem0/embedder" || true
              echo
              echo "mem0-init-config complete."
</file>

