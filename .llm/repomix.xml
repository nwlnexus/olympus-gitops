<file path="clusters/olympus/ingress-discovery/deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ingress-discovery
  namespace: ingress-discovery
spec:
  # Single replica to start. Safe to bump to 2 for HA — the controller is
  # leader-elected (coordination.k8s.io Lease `ingress-discovery-leader`), so
  # only the leader publishes; followers stay warm and report healthy.
  replicas: 1
  selector:
    matchLabels:
      app: ingress-discovery
  template:
    metadata:
      labels:
        app: ingress-discovery
    spec:
      serviceAccountName: ingress-discovery
      imagePullSecrets:
        - name: ghcr-pull
      securityContext:
        runAsNonRoot: true
        runAsUser: 65532
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: ingress-discovery
          # Pinned by tag (matches mem0's tag-pin convention). The pushed tag is
          # the short commit sha from olympus-sdk. Immutable digest equivalent:
          #   sha256:1e439266b0d70f2efa2359f233dfd84cc5a0003ec7a300885951475006717f1a
          image: ghcr.io/nwlnexus/ingress-discovery:8977a56
          ports:
            - name: health
              containerPort: 8080
          env:
            # Hermes is a Cloudflare Worker (NOT in-cluster). HERMES_URL is the
            # full GraphQL endpoint — the publisher POSTs the mutation directly
            # to this URL (no path is appended).
            - name: HERMES_URL
              value: "https://api.nwlnexus.net/graphql"
            # Bearer token carrying the `publish:app-launchers` capability.
            # Mounted from the ExternalSecret-managed Secret; never logged.
            - name: HERMES_PUBLISH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: ingress-discovery-credentials
                  key: hermes-publish-token
            # Leader-election lease lives in THIS namespace (downward API).
            - name: LEASE_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
            # Stable per-pod leader identity (downward API → pod name).
            - name: POD_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: HEALTH_PORT
              value: "8080"
            # Read by the tracing subscriber (NOT Config::from_env).
            - name: RUST_LOG
              value: "info"
          # GET /healthz → 200 whenever the reconcile loop is alive (followers
          # included — health is NOT gated on leadership).
          livenessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 10
            periodSeconds: 20
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: /healthz
              port: health
            initialDelaySeconds: 5
            periodSeconds: 10
            failureThreshold: 3
          securityContext:
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true
            capabilities:
              drop:
                - ALL
          resources:
            requests:
              memory: "64Mi"
              cpu: "25m"
            limits:
              memory: "128Mi"
              cpu: "250m"
</file>

<file path="clusters/olympus/ingress-discovery/externalsecret.yaml">
# Pulls the Hermes publish token into a k8s Secret consumed by the Deployment.
#
# OPERATOR PREREQUISITE: create a 1Password item BEFORE merge/deploy —
#   vault Dev → item `ingress-discovery` → field `hermes-publish-token`
# holding the bearer token minted for the controller (carries the
# `publish:app-launchers` capability). See README.md for the full token flow.
#
# NOTE: this repo's 1Password *Connect* provider addresses secrets by item
# name (`key`) + field name (`property`) — NOT op:// URIs. The ClusterSecretStore
# `onepassword-connect` exposes only vault `Dev`.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ingress-discovery-credentials
  namespace: ingress-discovery
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword-connect
    kind: ClusterSecretStore
  target:
    name: ingress-discovery-credentials
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: hermes-publish-token
      remoteRef:
        key: ingress-discovery
        property: hermes-publish-token
</file>

<file path="clusters/olympus/ingress-discovery/ghcr-pull-externalsecret.yaml">
# Image pull secret for the private ghcr.io/nwlnexus/ingress-discovery image.
# Modeled exactly on mem0/ghcr-pull-externalsecret.yaml so this namespace can
# pull the private GHCR package.
# Source: 1Password item `gh-pull-secret` (vault Dev) — fields `username` and
# `credential` (a PAT with read:packages on the nwlnexus org). Reusable across apps.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: ghcr-pull
  namespace: ingress-discovery
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword-connect
    kind: ClusterSecretStore
  target:
    name: ghcr-pull
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: kubernetes.io/dockerconfigjson
      data:
        .dockerconfigjson: |
          {"auths":{"ghcr.io":{"username":"{{ .username }}","password":"{{ .token }}","auth":"{{ printf "%s:%s" .username .token | b64enc }}"}}}
  data:
    - secretKey: username
      remoteRef:
        key: gh-pull-secret
        property: username
    - secretKey: token
      remoteRef:
        key: gh-pull-secret
        property: credential
</file>

