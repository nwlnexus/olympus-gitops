<file path="clusters/olympus/mem0/deployment.yaml">
apiVersion: apps/v1
kind: Deployment
metadata:
  name: openmemory
  namespace: mem0
spec:
  replicas: 1
  selector:
    matchLabels:
      app: openmemory
  strategy:
    # Recreate avoids two pods racing on the single RWO Longhorn volume (the
    # openmemory.db SQLite registry) during rollouts.
    type: Recreate
  template:
    metadata:
      labels:
        app: openmemory
    spec:
      imagePullSecrets:
        - name: ghcr-pull
      containers:
        - name: openmemory
          image: ghcr.io/nwlnexus/openmemory-mcp:sha-4fbecc0
          ports:
            - name: http
              containerPort: 8765
          env:
            # LLM + embedder run on the homelab Ollama (ai-hub). OLLAMA_BASE_URL is
            # set explicitly to a non-localhost URL so OpenMemory's Docker host-rewrite
            # path (host.docker.internal / bridge-gw) is bypassed and pods reach Ollama
            # over the tailnet MagicDNS name.
            - name: LLM_PROVIDER
              value: "ollama"
            # Fast NON-thinking extraction model. qwen3.6:27b-mlx (the coding model)
            # is a thinking model whose ~28s+/call extraction blocks OpenMemory's single
            # uvicorn worker past the liveness probe (~180s) → pod SIGKILL. qwen2.5:7b
            # extracts in seconds, never trips the probe. mem0 can't send think:false
            # (mem0/llms/ollama.py forwards only temperature/num_predict/top_p).
            - name: LLM_MODEL
              value: "qwen2.5:7b-instruct"
            - name: EMBEDDER_PROVIDER
              value: "ollama"
            - name: EMBEDDER_MODEL
              value: "nomic-embed-text"
            - name: OLLAMA_BASE_URL
              value: "http://ai-hub.raptor-mimosa.ts.net:11434"
            # Vector store = in-cluster Qdrant. memory.py keys off QDRANT_HOST/PORT to
            # select the qdrant provider; the init Job (mem0-init-config) then PUTs the
            # 768-dim override so the collection matches nomic-embed-text's output dims.
            - name: QDRANT_HOST
              value: "qdrant.mem0.svc.cluster.local"
            - name: QDRANT_PORT
              value: "6333"
            - name: USER
              value: "mnemosyne"
            # Persist the SQLite registry on the mounted volume (/data), NOT the WORKDIR
            # (/usr/src/openmemory) which holds the app code — mounting there masks main.py.
            - name: DATABASE_URL
              value: "sqlite:////data/openmemory.db"
            # OpenMemory's openai.OpenAI() client (app/utils/categorization.py) is
            # pointed at the cluster Ollama via OPENAI_BASE_URL below. The key is a
            # dummy that Ollama ignores, but must be non-empty so OpenAI() constructs
            # at import (else the app won't start). Only categorization uses this
            # client; the mem0 LLM/embedder are configured separately (ollama).
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: mem0-credentials
                  key: openai-api-key
            # Route categorization's OpenAI client at the cluster Ollama's
            # OpenAI-compatible endpoint (/v1). Affects categorization.py only.
            - name: OPENAI_BASE_URL
              value: "http://ai-hub.raptor-mimosa.ts.net:11434/v1"
            # Per-add categorization runs synchronously on every insert
            # (models.py:categorize_memory). ENABLED, routed at Ollama with a small
            # fast model (llama3.2:3b, ~0.5s/add, structured-output verified). Flip to
            # "true" to turn it off. CATEGORIZATION_MODEL is read by the image patch
            # (olympus-sdk openmemory.yml) and must be a model Ollama has pulled.
            - name: DISABLE_CATEGORIZATION
              value: "false"
            - name: CATEGORIZATION_MODEL
              value: "llama3.2:3b"
          # /health (added via the openmemory.yml image patch) is meant to be a
          # dependency-free route returning 200 iff the event loop is responsive.
          # REALITY (issue #43, verified on compute-hub 2026-07-08): an `add` still
          # blocks the single uvicorn worker (synchronous LLM extraction + categorization
          # + embed against ai-hub Ollama) long enough that /health itself times out —
          # liveness failed 52x / readiness 186x over 46h → 8 SIGKILL restarts (exitCode
          # 137, NOT OOM: usage ~164Mi/1Gi). Readiness de-pooling a single-replica Service
          # turns "busy" into "unreachable", which is what broke mnemosyne recall.
          # These probes are therefore relaxed to only act on a genuinely-wedged pod;
          # the real fix is making `add` non-blocking in the image (olympus-sdk
          # openmemory.yml) so /health stays fast — track/tighten again once that lands.
          startupProbe:
            httpGet:
              path: /health
              port: 8765
            periodSeconds: 10
            failureThreshold: 18 # up to ~180s for first-boot DB migration
            timeoutSeconds: 5
          # ~6min unresponsive before restart — kill only a truly wedged worker, not a busy one.
          livenessProbe:
            httpGet:
              path: /health
              port: 8765
            periodSeconds: 30
            timeoutSeconds: 10
            failureThreshold: 12
          # ~2min grace before de-pooling. Single replica: aggressive de-pool = self-inflicted outage.
          readinessProbe:
            httpGet:
              path: /health
              port: 8765
            periodSeconds: 15
            timeoutSeconds: 10
            failureThreshold: 8
          volumeMounts:
            - name: openmemory-data
              mountPath: /data
          resources:
            requests:
              memory: "256Mi"
              cpu: "200m"
            limits:
              memory: "1Gi"
              cpu: "1000m"
      volumes:
        - name: openmemory-data
          persistentVolumeClaim:
            claimName: openmemory-data
</file>

