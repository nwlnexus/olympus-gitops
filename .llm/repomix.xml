<file path="clusters/olympus/cert-manager/cloudflare-token-secret.yaml">
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: cloudflare-credentials
  namespace: cert-manager
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword-connect
    kind: ClusterSecretStore
  target:
    name: cloudflare-credentials
    creationPolicy: Owner
    deletionPolicy: Retain
  data:
    - secretKey: api-key
      remoteRef:
        key: cloudflare-account
        property: global_key
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
    - secretKey: api-email
      remoteRef:
        key: cloudflare-account
        property: email
        conversionStrategy: Default
        decodingStrategy: None
        metadataPolicy: None
</file>

<file path="clusters/olympus/cert-manager/helmrelease.yaml">
apiVersion: helm.toolkit.fluxcd.io/v2
kind: HelmRelease
metadata:
  name: cert-manager
  namespace: cert-manager
spec:
  interval: 1h
  chart:
    spec:
      chart: cert-manager
      version: "v1.16.2"
      sourceRef:
        kind: HelmRepository
        name: cert-manager
        namespace: cert-manager
  values:
    crds:
      enabled: true
    extraArgs:
      # Use public DNS for DNS-01 challenge verification — avoids CoreDNS
      # custom zone interference (e.g. tailscale-dns overrides causing SERVFAIL)
      - --dns01-recursive-nameservers=1.1.1.1:53,8.8.8.8:53
      - --dns01-recursive-nameservers-only
</file>

