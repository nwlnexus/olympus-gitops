  #   obs-stack-user = Grafana admin username, obs-stack-pass = admin password.
  data:
    - secretKey: admin-user
      remoteRef:
        key: olympus-obs-stack
        property: obs-stack-user
    - secretKey: admin-password
      remoteRef:
        key: olympus-obs-stack
        property: obs-stack-pass
</file>

