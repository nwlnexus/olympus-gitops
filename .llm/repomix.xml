      enabled: true
      isDefaultClass: true
    providers:
      kubernetesCRD:
        allowExternalNameServices: true
        ingressClass: traefik
      kubernetesIngress:
        enabled: true
        ingressClass: traefik
    ports:
      web:
        redirectTo:
          port: websecure
      websecure:
        tls:
          enabled: true
    api:
      dashboard: true
    metrics:
      prometheus:
        entryPoint: metrics
        service:
          enabled: true
        addEntryPointsLabels: true
        addServicesLabels: true
        addRoutersLabels: true
    logs:
      general:
        level: INFO
      access:
        enabled: true
        format: json
        fields:
          general:
            defaultmode: keep
            names:
              ClientAddr: keep
              RequestHost: keep
              RequestMethod: keep
              RequestPath: keep
              RequestProtocol: keep
              DownstreamStatus: keep
              Duration: keep
              RouterName: keep
              ServiceName: keep
          headers:
            defaultmode: drop
