<file path="clusters/olympus/qnap-storage/externalsecret.yaml">
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: qnap-trident-backend-creds
  namespace: trident
spec:
  refreshInterval: 1h
  secretStoreRef:
    name: onepassword-connect
    kind: ClusterSecretStore
  target:
    name: qnap-trident-backend-creds
    creationPolicy: Owner
    deletionPolicy: Retain
    template:
      type: Opaque
      data:
        username: "{{ .mgmtUsername }}"
        password: "{{ .mgmtPassword }}"
        storageAddress: "{{ .storageAddress }}"
        https: "false"
        port: "8080"
        chapInitiatorUsername: "{{ .chapInitiatorUsername }}"
        chapInitiatorPassword: "{{ .chapInitiatorPassword }}"
  data:
    # Shared QNAP management API account (same item used by all clusters)
    - secretKey: mgmtUsername
      remoteRef:
        key: qnap-csi
        property: username
    - secretKey: mgmtPassword
      remoteRef:
        key: qnap-csi
        property: password
    # Per-cluster iSCSI portal + CHAP credentials
    - secretKey: storageAddress
      remoteRef:
        key: compute-hub-qnap-iscsi
        property: storageAddress
